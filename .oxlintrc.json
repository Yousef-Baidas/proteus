// oxlint config for the lint gate (npm run lint), loading the vendored anti-slop plugin; exits 1 on any finding (--deny-warnings), 0 when clean.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    // the run panel mod (#311) is TypeScript against Claude Code's mod API, whose names (Shaped, shape) and untyped
    // tracker JSON these rules refuse; claude plugin validate and claude plugin test check it (tests/panel.test.js)
    "mods/*/hooks/*.tsx",
    "mods/*/test/*.ts",
    "mods/*/types/*.d.ts",
    "node_modules/**",
    "tests/fixtures/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // CONVENTIONS.md Types: "None ... Parse JSON defensively with defaults" - typeof is how plain JS checks parsed input, so the rule is off
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    // CONVENTIONS.md Style: "No formatter ... match the density of the file you are in; one-line guards ... are fine", so blank-line enforcement is off
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  }
}
